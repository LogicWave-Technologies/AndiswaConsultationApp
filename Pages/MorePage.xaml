<?xml version="1.0" encoding="utf-8" ?>
<!--
  MorePage.xaml  -  the MORE tab, built like a phone's Settings / Profile screen:
    - your account card at the top (logged in: your name; not logged in: "Sign in")
    - grouped lists: The studio, Help (quick answers open in place), App (dark mode switch right here)
    - the app version at the bottom
  The rows are created in MorePage.xaml.cs.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AndiswaConsultationApp.Pages.MorePage"
             BackgroundColor="{DynamicResource PageBg}"
             ControlTemplate="{StaticResource TabPage}"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20,44,20,28" Spacing="10">

            <Label Text="More" Style="{StaticResource ScreenTitle}" Margin="0,0,0,6" />

            <!-- ===== ACCOUNT CARD ===== -->
            <Border Style="{StaticResource Card}" Padding="16">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAccountTapped" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="56,*,Auto" ColumnSpacing="14">
                    <Border BackgroundColor="{DynamicResource Primary}" StrokeThickness="0" StrokeShape="RoundRectangle 28"
                            WidthRequest="56" HeightRequest="56">
                        <Label x:Name="AccountInitials" Text="?" FontSize="18" TextColor="{DynamicResource OnPrimary}"
                               FontFamily="{DynamicResource HeadingFont}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0">
                        <Label x:Name="AccountName" Text="Sign in" Style="{StaticResource CardTitle}" FontSize="16" />
                        <Label x:Name="AccountSub" Text="Track your quotes and projects" Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                    <Path Grid.Column="2" Stroke="{DynamicResource Soft}" StrokeThickness="2" StrokeLineCap="Round"
                          StrokeLineJoin="Round" WidthRequest="24" HeightRequest="24" VerticalOptions="Center"
                          Data="M9,18 L15,12 L9,6" />
                </Grid>
            </Border>

            <!-- ===== GROUPS (filled in MorePage.xaml.cs) ===== -->
            <Label Text="THE STUDIO" Style="{StaticResource Caption}" FontSize="11" Margin="8,14,0,0" />
            <Border Style="{StaticResource Card}" Padding="0">
                <VerticalStackLayout x:Name="StudioGroup" />
            </Border>

            <Label Text="HELP" Style="{StaticResource Caption}" FontSize="11" Margin="8,14,0,0" />
            <Border Style="{StaticResource Card}" Padding="0">
                <VerticalStackLayout x:Name="HelpGroup" />
            </Border>

            <Label Text="APP" Style="{StaticResource Caption}" FontSize="11" Margin="8,14,0,0" />
            <Border Style="{StaticResource Card}" Padding="0">
                <VerticalStackLayout Spacing="0">
                    <!-- Dark mode switch right here: no need to open another page -->
                    <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="14" Padding="16,10">
                        <Border Style="{StaticResource IconCircle}" WidthRequest="40" HeightRequest="40" StrokeShape="RoundRectangle 12">
                            <Label Text="🌙" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="1" Text="Dark mode" Style="{StaticResource CardTitle}" FontSize="14"
                               VerticalOptions="Center" />
                        <Switch x:Name="DarkSwitch" Grid.Column="2" OnColor="{DynamicResource Primary}"
                                VerticalOptions="Center" Toggled="OnDarkToggled" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="{DynamicResource Line}" Margin="70,0,0,0" />
                    <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="14" Padding="16,12">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSettingsTapped" />
                        </Grid.GestureRecognizers>
                        <Border Style="{StaticResource IconCircle}" WidthRequest="40" HeightRequest="40" StrokeShape="RoundRectangle 12">
                            <Label Text="Aa" FontSize="15" FontFamily="{DynamicResource HeadingFont}" TextColor="{DynamicResource Primary}"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0">
                            <Label Text="Font style" Style="{StaticResource CardTitle}" FontSize="14" />
                            <Label x:Name="FontNameLabel" Style="{StaticResource Caption}" FontSize="12" />
                        </VerticalStackLayout>
                        <Path Grid.Column="2" Stroke="{DynamicResource Soft}" StrokeThickness="2" StrokeLineCap="Round"
                              StrokeLineJoin="Round" WidthRequest="24" HeightRequest="24" VerticalOptions="Center"
                              Data="M9,18 L15,12 L9,6" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label x:Name="VersionLabel" Style="{StaticResource Caption}" FontSize="11"
                   HorizontalOptions="Center" Margin="0,18,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
