<?xml version="1.0" encoding="utf-8" ?>
<!--
  SettingsPage.xaml  -  dark mode and font style (opened from More).
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AndiswaConsultationApp.Pages.SettingsPage"
             Title="Settings"
             BackgroundColor="{DynamicResource PageBg}"
             Shell.NavBarIsVisible="True">

    <ScrollView>
        <VerticalStackLayout Padding="20,8,20,32" Spacing="10">

            <!-- ===== 1. DARK MODE ===== -->
            <Label Text="APPEARANCE" Style="{StaticResource Caption}" FontSize="11" Margin="8,6,0,0" />
            <Border Style="{StaticResource Card}" Padding="16,12">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                    <VerticalStackLayout VerticalOptions="Center" Spacing="0">
                        <Label Text="Dark mode" Style="{StaticResource CardTitle}" />
                        <Label Text="Easier on the eyes at night" Style="{StaticResource Caption}" FontSize="12" />
                    </VerticalStackLayout>
                    <Switch x:Name="DarkSwitch" Grid.Column="1" VerticalOptions="Center"
                            OnColor="{DynamicResource Primary}" Toggled="OnDarkToggled" />
                </Grid>
            </Border>

            <!-- ===== 2. FONT STYLE (rows are created in SettingsPage.xaml.cs) ===== -->
            <Label Text="FONT STYLE" Style="{StaticResource Caption}" FontSize="11" Margin="8,16,0,0" />
            <VerticalStackLayout x:Name="FontList" Spacing="10" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
