<?xml version="1.0" encoding="utf-8" ?>
<!--
  ServicesPage.xaml  -  the SERVICES tab.

  App style instead of the website's long sections:
    - filter chips at the top (All, Branding, Graphic, Digital, Business)
    - "Why choose us" as small cards you swipe sideways
    - one compact row per service with a coral "+" to start a quote for it
    - a "Not sure?" card that opens WhatsApp
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:AndiswaConsultationApp.Models"
             x:Class="AndiswaConsultationApp.Pages.ServicesPage"
             BackgroundColor="{DynamicResource PageBg}"
             ControlTemplate="{StaticResource TabPage}"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="0,44,0,28" Spacing="18">

            <!-- ===== 1. TITLE ===== -->
            <VerticalStackLayout Padding="20,0" Spacing="0">
                <Label Text="Services" Style="{StaticResource ScreenTitle}" />
                <Label Text="Tap + on any service to start a quote." Style="{StaticResource Caption}" />
            </VerticalStackLayout>

            <!-- ===== 2. FILTER CHIPS (created in ServicesPage.xaml.cs) ===== -->
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout x:Name="ChipLayout" Spacing="8" Padding="20,0" />
            </ScrollView>

            <!-- ===== 3. WHY CHOOSE US (swipe sideways) ===== -->
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="10" Padding="20,0"
                                       BindableLayout.ItemsSource="{x:Static models:SiteContent.Reasons}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="{DynamicResource AccentSoft}" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 18" Padding="14,12" WidthRequest="190">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding Title}" FontSize="13" FontFamily="{DynamicResource HeadingFont}"
                                           TextColor="{DynamicResource Accent}" />
                                    <Label Text="{Binding Description}" FontSize="12" LineHeight="1.3"
                                           TextColor="{DynamicResource Ink}" MaxLines="3" LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>

            <!-- ===== 4. THE SERVICES (filtered in ServicesPage.xaml.cs) ===== -->
            <VerticalStackLayout x:Name="ServiceList" Padding="20,0" Spacing="10">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="14">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnServiceTapped" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="14">
                                <Border Style="{StaticResource IconCircle}" VerticalOptions="Center">
                                    <Label Text="{Binding Icon}" FontSize="22"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding Title}" Style="{StaticResource CardTitle}" />
                                    <Label Text="{Binding Description}" FontSize="12" LineHeight="1.3"
                                           TextColor="{DynamicResource Muted}" />
                                </VerticalStackLayout>
                                <!-- coral "+" = request this service -->
                                <Border Grid.Column="2" BackgroundColor="{DynamicResource Accent}" StrokeThickness="0"
                                        StrokeShape="RoundRectangle 14" WidthRequest="36" HeightRequest="36"
                                        VerticalOptions="Center">
                                    <Path Stroke="White" StrokeThickness="2.4" StrokeLineCap="Round"
                                          WidthRequest="24" HeightRequest="24"
                                          HorizontalOptions="Center" VerticalOptions="Center" Data="M12,6 V18 M6,12 H18" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- ===== 5. NOT SURE? ===== -->
            <Border BackgroundColor="{DynamicResource PrimarySoft}" StrokeThickness="0" StrokeShape="RoundRectangle 20"
                    Padding="18" Margin="20,6,20,0">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                        <Label Text="Not sure what you need?" Style="{StaticResource CardTitle}" />
                        <Label Text="Send us a WhatsApp and we'll point you in the right direction."
                               Style="{StaticResource Caption}" FontSize="12" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="Chat" Style="{StaticResource PrimaryButton}" HeightRequest="44"
                            Padding="20,0" VerticalOptions="Center" Clicked="OnChatClicked" />
                </Grid>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
