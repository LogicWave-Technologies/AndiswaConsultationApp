<?xml version="1.0" encoding="UTF-8" ?>
<!--
  ErrorBox.xaml  -  a small banner pages show when something happens (like an app's "snackbar").
  Show(...) = red banner with "Retry";  ShowInfo(...) = soft blue note, no button.
  It has no outside margin: put it inside a page's padded layout.
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AndiswaConsultationApp.Controls.ErrorBox"
             IsVisible="False">

    <Border x:Name="Box" BackgroundColor="{DynamicResource ErrorBg}" StrokeThickness="0"
            StrokeShape="RoundRectangle 14" Padding="14,10">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
            <Label x:Name="IconLabel" Text="!" FontSize="15" FontFamily="{DynamicResource HeadingFont}"
                   TextColor="{DynamicResource ErrorText}" VerticalOptions="Center" />
            <Label x:Name="MessageLabel" Grid.Column="1" TextColor="{DynamicResource ErrorText}" FontSize="13"
                   VerticalOptions="Center" />
            <Button x:Name="RetryButton" Grid.Column="2" Text="Retry" FontSize="13" Padding="14,0"
                    BackgroundColor="{DynamicResource Surface}" TextColor="{DynamicResource ErrorText}"
                    CornerRadius="12" HeightRequest="36" VerticalOptions="Center" Clicked="OnRetryClicked" />
        </Grid>
    </Border>
</ContentView>
